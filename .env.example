# ============================================================================
# Academia Musical Digital — variáveis de ambiente
# ============================================================================
# Copie para `.env.local` (desenvolvimento). Em produção, configure como
# Environment Variables no painel do Cloudflare Pages.
#
# REGRA: apenas variáveis com prefixo VITE_ chegam ao navegador.
# Tudo abaixo SEM esse prefixo é segredo de servidor e jamais é empacotado.
# ============================================================================

# --- Cliente (público, vai para o bundle) -----------------------------------
# OAuth Client ID do Google (Google Cloud Console → Credenciais → ID do
# cliente OAuth 2.0 → tipo "Aplicativo da Web"). É público por natureza.
VITE_GOOGLE_OAUTH_CLIENT_ID=

VITE_APP_ENV=development
VITE_APP_NAME="Academia Musical Digital"

# --- Servidor (SEGREDO — nunca versionar, nunca prefixar com VITE_) ---------
# Mesmo Client ID acima; usado para validar a claim `aud` do ID token.
GOOGLE_OAUTH_CLIENT_ID=

# Administradores institucionais, separados por vírgula.
# Vazio = NENHUM administrador (falha fechada, por projeto).
ADMIN_ALLOWLIST=

# Chaves HMAC. Mínimo de 32 caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SIGNING_SECRET=
AUDIT_SIGNING_SECRET=

# Origem autorizada para CORS. Sem curinga.
ALLOWED_ORIGIN=http://localhost:3000
